// OPSIONAL / ARSIP — project ini sengaja TIDAK enable Firebase Storage
// (numpang GCS = can add money). Gambar pakai /public di Vercel atau URL eksternal.
// Kalau kapan pun bucket-nya dinyalain, barulah paste ini ke Storage → Rules.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /proker/{file} {
      allow read: if true;
      // ponytail: write cukup login — email allowlist baru ditegakkan di
      // rules Firestore (proker write). User login non-admin bisa nimpa file
      // tapi gak bisa nulis URL-nya ke DB, jadi sampah terisolasi.
      // Upgrade path: signed URL upload via route handler kalau mulai abused.
      allow write: if request.auth != null;
    }
  }
}
