rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ADMIN = user login yang punya dokumen di collection `admins` dengan
    // ID = persis alamat email-nya (contoh: admins/aditrachman23@gmail.com).
    // Tambah pengurus: collection admins -> Add document -> Choose ID manually
    // -> paste email login mereka. Hapus pengurus: hapus dokumen itu.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Admin boleh memastikan dirinya admin (dipakai route upload foto server-side).
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
    }

    match /proker/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // INFO TERBARU: seperti proker — publik baca, admin tulis.
    match /info/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // PENGURUS & VISI MISI (halaman /tentang-kami)
    match /pengurus/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /visi_misi/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ASPIRASI: publik boleh HANYA menambah (create) dengan isi terpantau —
    // gak bisa baca list orang, gak bisa ubah. Batas 5..1000 karakter.
    match /aspirasi/{doc} {
      allow create: if request.resource.data.pesan is string
                     && request.resource.data.pesan.size() >= 5
                     && request.resource.data.pesan.size() <= 1000
                     && request.resource.data.nama is string
                     && request.resource.data.nama.size() <= 100
                     && request.resource.data.prodi is string
                     && request.resource.data.prodi.size() <= 100
                     && request.resource.data.status == "baru";
      allow read, update, delete: if isAdmin();
    }
  }
}
